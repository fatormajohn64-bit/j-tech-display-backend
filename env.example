# ============================================
# J-Tech Display Backend — Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the ".env" file.
# ============================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Frontend ----
# Comma-separated list of allowed origins for CORS (e.g. https://app.jtechdisplay.com,http://localhost:19006)
FRONTEND_URL=

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Image Providers ----
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
WALLHAVEN_API_KEY=
